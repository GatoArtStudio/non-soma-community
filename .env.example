# Public URL of the app, without trailing slash. Used for OAuth redirects and links.
APP_URL=http://localhost:3000

# MySQL credentials. Docker Compose uses them to create the database and passes them to the app
# (host "db"), so nothing else is needed when deploying with compose. Any characters are allowed.
MYSQL_DATABASE=non_soma
MYSQL_USER=non_soma
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# Only for running the app or migrations outside Docker (npm run dev / npm run db:migrate).
# Ignored by Docker Compose, which always connects the app to the "db" service.
DATABASE_URL=mysql://non_soma:change-me@localhost:3306/non_soma

# At least 32 random characters. Signs sessions and hashes IPs/visitor ids. Generate with: openssl rand -base64 48
APP_SECRET=

# Kick developer app (https://kick.com/settings/developer). Redirect URI: ${APP_URL}/api/auth/kick/callback
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_CHANNEL_SLUG=elmune

# Cloudflare Turnstile. These defaults are Cloudflare's always-pass test keys for local development.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Hostname Turnstile must report for a valid token. Leave empty with the test keys.
TURNSTILE_EXPECTED_HOSTNAME=

# Set to true only when the app is reachable exclusively through Cloudflare (e.g. the server's Cloudflare Tunnel).
TRUST_CLOUDFLARE=false

